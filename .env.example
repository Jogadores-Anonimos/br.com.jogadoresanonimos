# Copie este arquivo para .env (raiz do projeto) e preencha com valores reais.
# .env nunca deve ser commitado. Este arquivo (.env.example) só documenta
# quais variáveis existem e formato esperado, sem segredo real.

# --- Postgres ---
DB_NAME=jogadoresanonimos
DB_USERNAME=postgres
DB_PASSWORD=troque-esta-senha-local

# --- Pool de conexão (Hikari) ---
DB_POOL_MAX=10
DB_POOL_MIN=5

# --- JWT ---
# Gere um valor aleatório forte, ex: openssl rand -base64 64
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-256-bits
JWT_TTL_MINUTES=60

# --- Log HMAC (correlação de tentativa de login/reset sem dado pessoal) ---
LOG_HMAC_SECRET=troque-por-outro-segredo-aleatorio

# --- CORS ---
CORS_ALLOWED_ORIGIN=http://localhost:4200

# --- Storage de imagem/PDF (disco local persistente, ver Decisoes de Sistemas.md seção 5) ---
# STORAGE_STUB_DIR: caminho DENTRO do container do backend (nome da env var mantido por
# compatibilidade, mas a implementação (LocalDiskStorageClient) já é real, não mais stub).
# Em docker-compose.yml esse caminho é montado como volume Docker nomeado (backend_storage),
# então sobrevive a restart/recreate do container.
# IMPORTANTE: esse diretório guarda imagem/PDF de usuário e PRECISA entrar na rotina de
# backup do servidor junto com o dump do Postgres (pendência se ainda não existir rotina).
STORAGE_STUB_DIR=./data/imagens
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/stub-storage

# --- Bootstrap do primeiro admin ---
ADMIN_BOOTSTRAP_APELIDO=admin
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_SENHA=troque-por-senha-forte-local

# --- Resend (e-mail transacional) ---
# Gere em resend.com -> API Keys -> Create (permissão Sending access).
RESEND_API_KEY=troque-pela-api-key-real-do-resend
